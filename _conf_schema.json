{
  "ccb_name": {
      "type": "string",
      "default": "ccb",
      "description": "踩踩背使用的代号"
  },
  "yw_window": {
    "description": "触发赛博阳痿的窗口时间（秒）",
    "type": "int",
    "default": 60,
    "hint": "统计多少秒内的调用次数。"
  },
  "yw_threshold": {
    "description": "窗口时间内最大ccb数",
    "type": "int",
    "default": 5,
    "hint": "同一人多少次请求后会被禁用。"
  },
  "yw_ban_duration": {
    "description": "养胃时长（秒）",
    "type": "int",
    "default": 900,
    "hint": "被触发限流后禁用多长时间。"
  },
  "yw_probability": {
    "description": "随机养胃概率",
    "type": "float",
    "default": 0.1,
    "hint": "每次 CCB 完成后，有多大概率养胃。"
  },
  "white_list": {
    "description": "不能进行ccb的id列表",
    "type": "list",
    "default": [],
    "hint": "当目标在此列表中时，不能对其ccb。"
  },
  "self_ccb": {
    "description": "是否允许0721",
    "type": "bool",
    "default": false,
    "hint": "为true时当ccb指令未指定对象时进行0721。"
  },
  "dis_ntr": {
    "description": "是否禁止NTR",
    "type": "bool",
    "default": false,
    "hint": "当为true时，有老婆/老公的群友不允许被其他人ccb，需要安装astrbot-plugin-wifepicker插件"
  },
  "crit_prob": {
    "description": "暴击概率",
    "type": "float",
    "default": 0.2,
    "hint": "ccb时暴击的概率。"
  },
  "attach_avatar": {
    "description": "附加头像",
    "type": "bool",
    "default": true,
    "hint": "为true时会在消息中附带头像，默认开启，不希望刷屏可以关掉"
  },
  "auto_delete": {
    "description": "自动撤回",
    "type": "bool",
    "default": false,
    "hint": "一段时间后自动撤回消息防止刷屏。"
  },
  "auto_delete_delay": {
        "type": "int",
        "description": "自动撤回延迟（秒）",
        "hint": "自动撤回的延迟时间，单位秒。仅在开启“自动撤回”时生效。",
        "default": 60,
        "slider": {
            "min": 3,
            "max": 90,
            "step": 1
        }
    },
  "is_log": {
    "description": "完整日志记录",
    "type": "bool",
    "default": false,
    "hint": "是否独立保留每一条ccb记录，包括双方与注入量。"
  }
}